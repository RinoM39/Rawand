{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "trailingSlash": false,
  "images": {
    "sizes": [
      384,
      640,
      960,
      1280,
      1920
    ],
    "qualities": [
      80
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "br-lingering-morning-b1edvcfd.storage.c-5.eu-central-1.aws.neon.tech"
      }
    ]
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://br-lingering-morning-b1edvcfd-api.compute.c-5.eu-central-1.aws.neon.tech/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://br-lingering-morning-b1edvcfd.storage.c-5.eu-central-1.aws.neon.tech/media/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/projects",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/api/project",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/(vendor|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(js|css)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/auth/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/auth",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
